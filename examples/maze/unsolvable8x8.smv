#word-width 6
MODULE maze

#hidden
#frozen
VAR
    space: boolean[64];

#inertial
VAR
    x, y : uint;

#hidden
DEFINE _ := FALSE;

#hidden
DEFINE O := TRUE;

-- Define the labyrinth space. 'O's are obstacles, while '_' are free
-- cells. The labyrinth doesn't change overtime.
INVAR
   0 <= x && 0 <= y;

INVAR
  x < 8 && y < 8;

INVAR
    space = [_,_,O,O,_,O,O,O,
             O,_,O,O,_,_,_,_,
             O,_,O,_,_,O,O,_,
             O,_,O,_,_,_,O,_,
             _,_,_,O,O,_,O,O,
             _,_,_,_,O,_,O,_,
             _,O,O,_,_,_,O,_,
             _,_,_,_,O,O,O,_];

-- our guy starts at the top-left corner,
INIT
   x = 0 && y = 0;

-- he can not occupy a cell which holds an obstacle...

#hidden
DEFINE
  addr := y * 8 + x;

INVAR
  ! space [addr];

-- Move one cell along exactly one axis. Bounds and obstacles remain
-- state constraints; movement is a transition between two states.
TRANS
  x := {x - 1, x, x + 1};
TRANS
  next(x) = x ?: y := {y - 1, y + 1};
TRANS
  next(x) != x ?: y := y;

-- his target is the bottom-right corner
#hidden
DEFINE
  GOAL := x = 7 && y = 7;

-- to solve the labyrinth issue the command:
-- >> check reachable GOAL -method interpolation;
