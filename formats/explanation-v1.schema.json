{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified high-level UNSAT explanation v1",
  "type": "object", "additionalProperties": false,
  "required": ["version", "scope", "bound", "prefix_length", "query", "background", "cases"],
  "properties": {
    "version": {"const": 1},
    "scope": {"enum": ["initial_state", "single_step_continuation", "through_depth", "exact_depth"]},
    "bound": {"type": "integer", "minimum": 0},
    "prefix_length": {"type": "integer", "minimum": 0},
    "query": {"type": "object"}, "background": {"type": "string"},
    "cases": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["depth", "verified_unsat", "subset_minimal", "candidate_count", "minimization", "constraints"],
      "properties": {
        "depth": {"type": "integer", "minimum": 0}, "verified_unsat": {"const": true},
        "subset_minimal": {"type": "boolean"}, "candidate_count": {"type": "integer", "minimum": 0},
        "minimization": {"type": "object", "required": ["checks", "stop_reason"], "additionalProperties": false,
          "properties": {"checks": {"type": "integer", "minimum": 0}, "stop_reason": {"type": "string"}}},
        "constraints": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["id", "kind", "step", "expression", "source_ids"],
          "properties": {"id": {"type": "string"}, "kind": {"enum": ["init", "invar", "trans", "pin", "assumption", "goal"]},
            "step": {"type": "integer", "minimum": 0}, "expression": {"type": "string"}, "source_ids": {"type": "array", "items": {"type": "string"}}}}}
      }
    }}
  }
}
