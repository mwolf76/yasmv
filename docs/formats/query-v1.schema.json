{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "model": {
      "type": "string"
    },
    "query": {
      "type": "object",
      "properties": {
        "operation": {
          "enum": [
            "validate-model",
            "check-init",
            "check-trans",
            "pick-state",
            "reach",
            "simulate",
            "diameter",
            "validate-trace",
            "explain-init",
            "explain-step",
            "explain-reach",
            "shortest-reach",
            "check-property",
            "prove-property"
          ]
        },
        "request_id": {
          "type": "string"
        },
        "strategy": {
          "enum": [
            "auto",
            "forward",
            "backward"
          ]
        },
        "target": {
          "type": "string"
        },
        "until": {
          "type": "string"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "depth": {
              "type": "integer",
              "minimum": -1
            },
            "states": {
              "type": "integer",
              "minimum": -1
            },
            "wall_ms": {
              "type": "integer",
              "minimum": -1
            },
            "conflicts": {
              "type": "integer",
              "minimum": -1
            },
            "propagations": {
              "type": "integer",
              "minimum": -1
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "count": {
          "type": "boolean"
        },
        "enumerate": {
          "type": "boolean"
        },
        "trace_id": {
          "type": "string"
        },
        "trace": {
          "type": "object"
        },
        "parent_trace": {
          "type": "object"
        },
        "prefix_length": {
          "type": "integer",
          "minimum": 1
        },
        "watches": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Named Boolean state expressions, evaluated on result trace frames."
        },
        "explanation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimize": {
              "type": "boolean"
            },
            "checks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "wall_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "exact_depth": {
              "type": "boolean"
            },
            "active_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "property": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "expression"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "expression": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "required": [
        "operation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "check-property",
                  "prove-property"
                ]
              }
            }
          },
          "then": {
            "required": [
              "property",
              "limits"
            ],
            "properties": {
              "limits": {
                "required": [
                  "depth"
                ],
                "properties": {
                  "depth": {
                    "minimum": 0
                  }
                }
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "property"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "prove-property"
              }
            }
          },
          "then": {
            "properties": {
              "limits": {
                "properties": {
                  "depth": {
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "shortest-reach"
              }
            }
          },
          "then": {
            "required": [
              "target",
              "limits"
            ],
            "properties": {
              "limits": {
                "required": [
                  "depth"
                ],
                "properties": {
                  "depth": {
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "version",
    "model",
    "query"
  ],
  "additionalProperties": false
}
