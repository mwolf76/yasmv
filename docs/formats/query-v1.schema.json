{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "model": {
      "type": "string"
    },
    "query": {
      "type": "object",
      "properties": {
        "operation": {
          "enum": [
            "validate-model",
            "check-init",
            "check-trans",
            "pick-state",
            "reach",
            "simulate",
            "diameter",
            "validate-trace",
            "explain-init",
            "explain-step",
            "explain-reach",
            "shortest-reach",
            "check-property",
            "prove-property",
            "check-progress",
            "validate-progress"
          ]
        },
        "request_id": {
          "type": "string"
        },
        "strategy": {
          "enum": [
            "auto",
            "forward",
            "backward",
            "interpolation"
          ]
        },
        "target": {
          "type": "string"
        },
        "until": {
          "type": "string"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "depth": {
              "type": "integer",
              "minimum": -1
            },
            "states": {
              "type": "integer",
              "minimum": -1
            },
            "wall_ms": {
              "type": "integer",
              "minimum": -1
            },
            "conflicts": {
              "type": "integer",
              "minimum": -1
            },
            "propagations": {
              "type": "integer",
              "minimum": -1
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "count": {
          "type": "boolean"
        },
        "enumerate": {
          "type": "boolean"
        },
        "trace_id": {
          "type": "string"
        },
        "trace": {
          "type": "object"
        },
        "parent_trace": {
          "type": "object"
        },
        "prefix_length": {
          "type": "integer",
          "minimum": 1
        },
        "watches": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Named Boolean state expressions, evaluated on result trace frames."
        },
        "explanation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimize": {
              "type": "boolean"
            },
            "checks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "wall_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "exact_depth": {
              "type": "boolean"
            },
            "active_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "property": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "expression"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "expression": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "progress": {
          "oneOf": [
            {
              "$ref": "progress-proof-v1.schema.json"
            },
            {
              "$ref": "progress-counterexample-v1.schema.json"
            }
          ]
        }
      },
      "required": [
        "operation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "check-property",
                  "prove-property"
                ]
              }
            }
          },
          "then": {
            "required": [
              "property",
              "limits"
            ],
            "properties": {
              "limits": {
                "required": [
                  "depth"
                ],
                "properties": {
                  "depth": {
                    "minimum": 0
                  }
                }
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "property"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "prove-property"
              }
            }
          },
          "then": {
            "properties": {
              "limits": {
                "properties": {
                  "depth": {
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "shortest-reach"
              }
            }
          },
          "then": {
            "required": [
              "target",
              "limits"
            ],
            "properties": {
              "limits": {
                "required": [
                  "depth"
                ],
                "properties": {
                  "depth": {
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "check-progress",
                  "validate-progress"
                ]
              }
            }
          },
          "then": {
            "required": [
              "limits"
            ],
            "properties": {
              "limits": {
                "required": [
                  "states",
                  "wall_ms"
                ],
                "properties": {
                  "states": {
                    "minimum": 1
                  },
                  "wall_ms": {
                    "minimum": 0
                  },
                  "depth": {
                    "const": -1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "check-progress"
              }
            }
          },
          "then": {
            "required": [
              "target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "validate-progress"
              }
            }
          },
          "then": {
            "required": [
              "progress"
            ],
            "not": {
              "required": [
                "target"
              ]
            }
          },
          "else": {
            "not": {
              "required": [
                "progress"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "interpolation"
              }
            },
            "required": [
              "strategy"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "operation": {
                    "const": "reach"
                  },
                  "limits": {
                    "properties": {
                      "depth": {
                        "const": -1
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "operation": {
                    "const": "prove-property"
                  }
                }
              }
            ]
          },
          "else": {
            "if": {
              "properties": {
                "operation": {
                  "not": {
                    "enum": [
                      "reach",
                      "shortest-reach"
                    ]
                  }
                }
              }
            },
            "then": {
              "properties": {
                "strategy": {
                  "const": "auto"
                }
              }
            }
          }
        }
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "version",
    "model",
    "query"
  ],
  "additionalProperties": false
}
