                  ]
                },
                {
                  "required": [
                    "prefix_length"
                  ]
                },
                {
                  "required": [
                    "explanation"
                  ]
                },
                {
                  "required": [
                    "progress"
                  ]
                },
                {
                  "required": [
                    "count"
                  ]
                },
                {
                  "required": [
                    "enumerate"
                  ]
                }
              ]
