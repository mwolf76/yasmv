{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M4 analysis result evidence v1",
  "type": "object",
  "required": [
    "version",
    "status",
    "outcome",
    "scope",
    "optimality",
    "proof"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "status": {
      "enum": [
        "completed",
        "unknown",
        "error"
      ]
    },
    "outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "type": "string"
    },
    "optimality": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "criterion",
        "certified",
        "depth",
        "unsat_depths",
        "method"
      ],
      "additionalProperties": false,
      "properties": {
        "criterion": {
          "const": "transitions"
        },
        "certified": {
          "const": true
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "unsat_depths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "method": {
          "const": "increasing-depth-exhaustion"
        }
      }
    },
    "proof": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "property": {
          "type": "object",
          "required": [
            "name",
            "expression"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "expression": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "base_unsat_depths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "induction_depth": {
          "type": "integer",
          "minimum": 1
        },
        "step_status": {
          "enum": [
            "satisfiable",
            "unsatisfiable"
          ]
        },
        "verified": {
          "type": "boolean"
        },
        "verified_base_depths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "verification": {
          "const": "fresh-solvers"
        },
        "induction_counterexample": {
          "type": "object",
          "required": [
            "trace",
            "reachable",
            "meaning"
          ],
          "properties": {
            "trace": {
              "type": "object"
            },
            "reachable": {
              "const": "not_established"
            },
            "meaning": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "initial_satisfiable": {
          "type": "boolean"
        },
        "vacuous": {
          "type": "boolean"
        },
        "invariant": {
          "$ref": "invariant-v1.schema.json"
        },
        "obligations": {
          "type": "object",
          "required": [
            "initial_containment",
            "transition_closure",
            "target_exclusion"
          ],
          "additionalProperties": false,
          "properties": {
            "initial_containment": {
              "const": "unsatisfiable"
            },
            "transition_closure": {
              "const": "unsatisfiable"
            },
            "target_exclusion": {
              "const": "unsatisfiable"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "progress": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "progress-proof-v1.schema.json"
        },
        {
          "$ref": "progress-counterexample-v1.schema.json"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "proven"
          },
          "proof_method": {
            "const": "k-induction"
          }
        },
        "required": [
          "proof_method"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "completed"
          },
          "scope": {
            "const": "unbounded"
          },
          "trace": {
            "type": "null"
          },
          "proof": {
            "type": "object",
            "required": [
              "property",
              "assumptions",
              "base_unsat_depths",
              "induction_depth",
              "verified_base_depths",
              "step_status",
              "verified",
              "verification"
            ],
            "properties": {
              "verified": {
                "const": true
              },
              "step_status": {
                "const": "unsatisfiable"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "unknown",
              "error"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "optimality": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proof_method": {
            "const": "finite-graph-ranking"
          },
          "outcome": {
            "const": "proven"
          }
        },
        "required": [
          "proof_method",
          "outcome"
        ]
      },
      "then": {
        "required": [
          "progress"
        ],
        "properties": {
          "scope": {
            "const": "unbounded"
          },
          "status": {
            "const": "completed"
          },
          "proof": {
            "required": [
              "verified",
              "verification",
              "vacuous",
              "initial_satisfiable"
            ],
            "properties": {
              "verified": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proof_method": {
            "const": "interpolation"
          }
        },
        "required": [
          "proof_method"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "completed"
          },
          "outcome": {
            "enum": [
              "proven",
              "unreachable"
            ]
          },
          "scope": {
            "const": "unbounded"
          },
          "trace": {
            "type": "null"
          },
          "proof": {
            "type": "object",
            "required": [
              "verified",
              "verification",
              "vacuous",
              "initial_satisfiable",
              "assumptions",
              "invariant",
              "obligations"
            ],
            "properties": {
              "verified": {
                "const": true
              }
            }
          },
          "statistics": {
            "type": "object",
            "required": [
              "interpolation"
            ],
            "properties": {
              "interpolation": {
                "type": "object",
                "required": [
                  "horizon",
                  "images",
                  "enlargements",
                  "restarts",
                  "concrete_sat",
                  "spurious_sat",
                  "proof_nodes",
                  "circuit_nodes"
                ],
                "additionalProperties": false,
                "properties": {
                  "horizon": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "images": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "enlargements": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "restarts": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "concrete_sat": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "spurious_sat": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "proof_nodes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "circuit_nodes": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "required": [
          "statistics"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "proof": {
            "type": "object",
            "required": [
              "invariant"
            ]
          }
        }
      },
      "then": {
        "required": [
          "proof_method"
        ],
        "properties": {
          "proof_method": {
            "const": "interpolation"
          }
        }
      }
    }
  ]
}
